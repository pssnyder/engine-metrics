{
  "ingest_layer_config": {
    "storage": {
      "bucket_name": "chess-engine-metrics-agent.firebasestorage.app",
      "credentials_path": null
    },
    "bigquery": {
      "project_id": "chess-engine-metrics-agent",
      "dataset_name": "chess_engine_data_lake",
      "location": "US"
    },
    "processing": {
      "max_workers": 4,
      "batch_size": 100,
      "max_file_size_mb": 50,
      "supported_extensions": [".pgn", ".json", ".md", ".txt", ".csv"]
    },
    "monitoring": {
      "polling_interval": 60,
      "enable_pubsub": false,
      "pubsub_topic": null,
      "enable_cloud_functions": false
    },
    "data_quality": {
      "validate_schema": true,
      "reject_invalid_records": false,
      "max_retries": 3,
      "enable_deduplication": true
    },
    "logging": {
      "level": "INFO",
      "max_file_size_mb": 10,
      "backup_count": 5,
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    },
    "tables": {
      "games": {
        "table_name": "pgn_games",
        "partition_field": "date",
        "clustering_fields": ["white", "black", "result"]
      },
      "analysis": {
        "table_name": "analysis_results", 
        "partition_field": "analysis_date",
        "clustering_fields": ["engine_version", "analysis_type"]
      },
      "documentation": {
        "table_name": "documentation",
        "partition_field": "created_date",
        "clustering_fields": ["engine_version", "doc_type"]
      }
    }
  }
}
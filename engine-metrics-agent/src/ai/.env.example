# ═══════════════════════════════════════════════════════════
#  V7P3R Engine Metrics Agent - Environment Configuration
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to git (it's gitignored).
# ═══════════════════════════════════════════════════════════

# ── Gemini API Authentication ────────────────────────────
# Option A: Google AI Studio API key (simplest - get one at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Vertex AI via service account (leave GEMINI_API_KEY empty to use this)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# GOOGLE_CLOUD_LOCATION=us-central1

# ── GCP / Firebase ────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=chess-engine-metrics-agent
FIREBASE_STORAGE_BUCKET=chess-engine-metrics-agent.firebasestorage.app

# ── Agent Settings ────────────────────────────────────────
# gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
# Keep LOW for precise analytical responses (0.0 = deterministic, 1.0 = creative)
AGENT_TEMPERATURE=0.15
AGENT_MAX_TOKENS=8192

# ── Stockfish ─────────────────────────────────────────────
STOCKFISH_PATH=C:\Users\Pat\Documents\Software\stockfish_12_win_x64_bmi2\stockfish_20090216_x64_bmi2.exe

# ── Flask AI Service (web API mode) ───────────────────────
FLASK_ENV=development
FLASK_DEBUG=false
PORT=5002
        Out1["💡 Insights<br/>Performance analysis<br/>Error patterns<br/>Recommendations"]
        Out2["📈 Metrics<br/>Win rates<br/>ELO trends<br/>Accuracy stats"]
        Out3["🎯 Actions<br/>Opening improvements<br/>Tactical focus areas<br/>Version decisions"]
    end
    
    %% Main Flow
    Input --> RawLayer
    RawLayer --> ProcessLayer
    ProcessLayer --> ConformedLayer
    ConformedLayer --> IntelligenceLayer
    IntelligenceLayer --> InterfaceLayer
    InterfaceLayer --> Output
    
    %% Detailed connections
    Source1 --> Raw1
    Source2 --> Raw2
    Source3 --> Raw3
    
    Raw1 --> Proc1
    Raw1 --> Proc2
    Raw1 --> Proc4
    Raw2 --> Proc4
    Raw3 --> Proc4
    
    Proc1 --> Conf1
    Proc2 --> Conf2
    Proc3 --> Conf3
    Conf1 --> Conf4
    Conf2 --> Conf4
    Conf3 --> Conf4
    
    Conf4 --> AI
    Tools <--> AI
    AI <--> UI
    
    UI --> Out1
    UI --> Out2
    UI --> Out3
    
    %% Feedback Loop
    Out3 -.->|Triggers| Proc1
    Out3 -.->|Updates| Source2
    

        subgraph ReportsOutput["reports/"]
            GameplayReport[v7p3r_recent_gameplay_report_latest.txt<br/>Performance summary]
            VersionCompare[v7p3r_version_comparison_report_latest.txt<br/>Cross-version analysis]

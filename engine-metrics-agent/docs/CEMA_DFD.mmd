        end
        
        NotationEvents[notation_events.json<br/>Operational Events<br/>Non-engine changes]
    end

    %% ============================================================
    %% PROCESSING LAYER
    %% ============================================================
    subgraph Processing["⚙️ Data Processing & Analysis"]
        direction TB
        
        subgraph StockfishAnalysis["Stockfish Analysis Scripts"]
            AnalyzeYTD[scripts/analyze_ytd_games.py<br/>Depth 18 analysis<br/>Blunder/mistake detection]
        end
        
        subgraph ReportingScripts["Reporting Scripts"]
            ExtractGame[extract_game_data.py<br/>CSV extraction]
            ExtractMove[extract_move_data.py<br/>Move-level data]
            GenReport[generate_gameplay_report.py<br/>TXT report generation]
            GenInsights[generate_insights_report.py<br/>Markdown insights]
        end
        
        subgraph AIDataLoader["AI Agent Data Loader"]
            DataLoader[data_loader.py<br/>Context aggregation<br/>Multi-source integration]
        end
    end

    %% ============================================================
    %% CONFORMED DATA LAYER
    %% ============================================================
    subgraph ConformedData["💾 Conformed Datasets"]

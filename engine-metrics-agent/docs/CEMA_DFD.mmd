        end
        
        subgraph StockfishTools["Stockfish Function Tools"]
            ToolStatus[stockfish_status<br/>Engine availability]
            ToolAnalyze[analyze_position<br/>FEN evaluation]
            ToolBestMoves[find_best_moves<br/>Top N moves]
            ToolGameAnalysis[analyze_game_pgn<br/>Full game analysis]
            ToolKeyPos[get_game_key_positions<br/>Opening/mid/endgame]
        end
        
        UserInterface[🖥️ Interactive Terminal<br/>run_agent.py CLI<br/>Single-query mode<br/>Conversational REPL]
    end

    %% ============================================================
    %% FEEDBACK & ITERATION LAYER
    %% ============================================================
    subgraph Feedback["🔄 Feedback & Continuous Improvement"]
        UserQueries[User Questions<br/>Analysis requests<br/>Performance queries]
        AgentResponses[AI Insights<br/>Recommendations<br/>Pattern identification]
        NewAnalysis[Triggered Analysis<br/>Re-run Stockfish<br/>Generate new reports]
    end

    %% ============================================================
    %% DATA FLOW CONNECTIONS
    %% ============================================================
    
    %% Generation → Raw Sources
    V7P3RBot -->|Play games daily| LichessPGN
    V7P3RLocal -->|Engine battles| EngineBattles
    DevLogs -->|Document changes| Changelog
    DevLogs -->|Design notes| DevDocs
    
    %% Raw Sources → Processing
    LichessPGN -->|Parse PGN| AnalyzeYTD
    LichessPGN -->|Extract metadata| ExtractGame
    LichessPGN -->|Parse moves| ExtractMove
    StockfishEngine -->|Analyze games| AnalyzeYTD
    
    AnalyzeYTD -->|Generate JSON| StockfishJSON
    
    %% Processing → Conformed
    ExtractGame -->|Generate CSV| GameData
    ExtractMove -->|Generate CSV| MoveData
    GenReport -->|Generate TXT| GameplayReport
    GenInsights -->|Generate MD| InsightsReport
    
    %% All sources → AI Data Loader
    GameData -->|Load game stats| DataLoader
    StockfishJSON -->|Load error analysis| DataLoader
    Changelog -->|Parse version info| DataLoader
    NotationEvents -->|Load operational events| DataLoader
    LichessPGN -->|Load recent games| DataLoader
    DevDocs -->|Load design docs| DataLoader
    
    %% Data Loader → Agent
    DataLoader -->|Build context| KnowledgeBase
    KnowledgeBase -->|System prompt| AgentCore
    
    %% Stockfish tools connection
    StockfishEngine -.->|Real-time calls| ToolAnalyze
    StockfishEngine -.->|Real-time calls| ToolBestMoves
    StockfishEngine -.->|Real-time calls| ToolGameAnalysis
    
    %% Agent → Tools → User
    AgentCore <-->|Function calling| StockfishTools
    AgentCore -->|Response| UserInterface
    UserInterface -->|Query| AgentCore
    
    %% Feedback loops
    UserInterface -->|User queries| UserQueries
    AgentCore -->|Insights| AgentResponses
    AgentResponses -->|Identify needs| NewAnalysis
    NewAnalysis -->|Re-analyze| AnalyzeYTD
    
    %% Optional cloud sync
    GameData -.->|Optional upload| BigQuery
    LichessPGN -.->|Optional sync| Firebase
    

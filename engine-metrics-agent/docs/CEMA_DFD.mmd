        end
    end

    %% ============================================================
    %% CONSUMPTION LAYER
    %% ============================================================
    subgraph Consumption["🤖 Data Consumption & Analytics"]
        direction TB
        
        subgraph GeminiAgent["Gemini AI Agent"]
            AgentCore[V7P3RAgent<br/>gemini-2.5-flash<br/>Temperature: 0.15]

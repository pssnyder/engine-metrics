{
  "name": "v7p3r-chess-analytics",
  "version": "1.0.0",
  "description": "Sustainable data pipeline for V7P3R chess engine analytics",
  "main": "src/backend/functions/index.js",
  "scripts": {
    "setup": "npm run install:all && npm run setup:hooks && npm run validate:env",
    "dev": "concurrently \"npm run dev:emulators\" \"npm run dev:frontend\"",
    "dev:emulators": "firebase emulators:start --only functions,firestore,storage",
    "dev:frontend": "cd src/frontend && npm start",
    "dev:analytics": "cd src/backend/analytics && python -m flask run --port=5020",
    "build": "npm run build:functions && npm run build:frontend",
    "build:functions": "cd src/backend/functions && npm run build",
    "build:frontend": "cd src/frontend && npm run build",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "playwright test",
    "test:python": "cd src/backend/analytics && python -m pytest tests/ -v --cov=.",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint src/ --ext .js,.ts,.tsx --fix",
    "lint:py": "cd src/backend/analytics && flake8 . && black --check .",
    "format": "npm run format:js && npm run format:py",
    "format:js": "prettier --write \"src/**/*.{js,ts,tsx,json,md}\"",
    "format:py": "cd src/backend/analytics && black . && isort .",
    "type-check": "tsc --noEmit",
    "pre-commit": "npm run lint && npm run type-check && npm run test:unit",
    "deploy:staging:old": "firebase use staging && firebase deploy",
    "deploy:prod:old": "firebase use production && firebase deploy",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "logs": "firebase functions:log",
    "install:all": "npm install && cd src/frontend && npm install && cd ../../src/backend/functions && npm install",
    "setup:hooks": "husky install && husky add .husky/pre-commit \"npm run pre-commit\"",
    "validate:env": "node scripts/validate-environment.js",
    "validate:infrastructure": "node scripts/validate-infrastructure.js",
    "configure:dev": "node scripts/configure-firebase.js development",
    "configure:staging": "node scripts/configure-firebase.js staging",
    "configure:prod": "node scripts/configure-firebase.js production",
    "deploy:dev": "node scripts/deploy.js development",
    "deploy:staging": "node scripts/deploy.js staging",
    "deploy:prod": "node scripts/deploy.js production --confirm",
    "clean": "rimraf dist/ coverage/ .nyc_output/ */node_modules/.cache"
  },
  "keywords": [
    "chess",
    "analytics",
    "firebase",
    "data-pipeline",
    "lichess",
    "v7p3r",
    "sustainable",
    "best-practices"
  ],
  "author": "Pat Snyder <pat@rapidtechconsultants.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pssnyder/engine-metrics.git"
  },
  "engines": {
    "node": "18",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase": "^10.7.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.6.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "concurrently": "^7.6.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^14.0.1",
    "nodemon": "^3.0.2",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.py": [
      "black",
      "isort",
      "flake8"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.{js,ts}",
      "**/src/**/__tests__/**/*.test.{js,ts}"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!src/**/*.d.ts",
      "!src/frontend/**/*"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}

# V7P3R Chess Analytics - Environment Configuration
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development

# Firebase Configuration
FIREBASE_PROJECT_ID=chess-engine-metrics-agent
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=chess-engine-metrics-agent.firebaseapp.com
FIREBASE_STORAGE_BUCKET=chess-engine-metrics-agent.firebasestorage.app

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GCP_PROJECT_ID=chess-engine-metrics-agent
GCP_REGION=us-central1

# Lichess API Configuration
LICHESS_API_TOKEN=lip_1vCANjDGz9euqYAcXwy7
LICHESS_BOT_USERNAME=v7p3r_bot

# E2 Instance Configuration
E2_INSTANCE_NAME=v7p3r-production-bot
E2_ZONE=us-central1-a
E2_PROJECT=v7p3r-lichess-bot

# Development Configuration
PORT=3000
ANALYTICS_PORT=5020
EMULATOR_PORT=9099
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# Security
JWT_SECRET=your-jwt-secret-for-development
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=pat@rapidtechconsultants.com

# AI Configuration (Optional)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-pro
MAX_TOKENS=4096
TEMPERATURE=0.7

# Data Processing Configuration
BATCH_SIZE=100
MAX_FILE_SIZE=10MB
SUPPORTED_FORMATS=pgn,json,md,csv
MAX_GAMES_PER_FETCH=30

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_ANALYTICS=true
# Production Environment Variables Template
# These should be managed through secure secret management systems
# NEVER store production secrets in files - use Firebase Functions config or cloud secret managers

# =============================================================================
# LICHESS API CONFIGURATION - PRODUCTION
# =============================================================================
# Lichess API token for v7p3r_bot (PRODUCTION - SECURE STORAGE REQUIRED)
LICHESS_API_TOKEN=SECURE_VAULT_lichess_api_token
LICHESS_BOT_USERNAME=v7p3r_bot
LICHESS_API_BASE_URL=https://lichess.org/api

# Rate limiting for production (strict)
LICHESS_RATE_LIMIT_PER_HOUR=1000
LICHESS_REQUEST_TIMEOUT=15000
LICHESS_RETRY_ATTEMPTS=3
LICHESS_RETRY_DELAY=10000
LICHESS_CIRCUIT_BREAKER_THRESHOLD=5

# =============================================================================
# FIREBASE CONFIGURATION - PRODUCTION
# =============================================================================
# Firebase project configuration for production
FIREBASE_PROJECT_ID=chess-engine-metrics-agent
FIREBASE_DATABASE_URL=https://chess-engine-metrics-agent-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=chess-engine-metrics-agent.appspot.com

# Firebase Functions configuration (production-optimized)
FUNCTIONS_TIMEOUT=540s
FUNCTIONS_MEMORY=1GB
FUNCTIONS_MIN_INSTANCES=1
FUNCTIONS_MAX_INSTANCES=10
FUNCTIONS_CONCURRENCY=80

# =============================================================================
# GOOGLE CLOUD CONFIGURATION - PRODUCTION
# =============================================================================
# Google Cloud project for E2 instance integration
GCP_PROJECT_ID=v7p3r-lichess-bot
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=v7p3r-production-bot

# Service account for GCP operations (production - managed by secret manager)
GOOGLE_APPLICATION_CREDENTIALS=SECURE_VAULT_gcp_service_account

# =============================================================================
# APPLICATION CONFIGURATION - PRODUCTION
# =============================================================================
# Node.js environment
NODE_ENV=production

# Logging configuration (minimal for production)
LOG_LEVEL=warn
ENABLE_DETAILED_LOGGING=false
ENABLE_REQUEST_LOGGING=false
ENABLE_ERROR_REPORTING=true
LOG_RETENTION_DAYS=30

# Security configuration (maximum security)
ENABLE_CORS=false
CORS_ORIGINS=https://chess-engine-metrics-agent.web.app
ENABLE_RATE_LIMITING=true
ENABLE_AUTH_VALIDATION=true
REQUIRE_EMAIL_VERIFICATION=true
ENABLE_2FA=true

# =============================================================================
# DATABASE CONFIGURATION - PRODUCTION
# =============================================================================
# Firestore settings (production-optimized)
FIRESTORE_CACHE_SIZE=50MB
FIRESTORE_OFFLINE_PERSISTENCE=false
FIRESTORE_CONNECTION_POOL_SIZE=20
FIRESTORE_TRANSACTION_TIMEOUT=30000

# Database security
ENABLE_AUDIT_LOGGING=true
ENABLE_DATA_ENCRYPTION=true
BACKUP_ENCRYPTION_ENABLED=true

# =============================================================================
# AI SERVICE CONFIGURATION - PRODUCTION
# =============================================================================
# AI service configuration (production)
AI_SERVICE_PORT=5020
AI_SERVICE_HOST=localhost
AI_MODEL_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_RATE_LIMIT_PER_MINUTE=50
AI_TIMEOUT_SECONDS=30

# =============================================================================
# ANALYTICS CONFIGURATION - PRODUCTION
# =============================================================================
# Analytics and reporting (production)
ANALYTICS_BATCH_SIZE=25
ANALYTICS_PROCESSING_INTERVAL=900000
ENABLE_REAL_TIME_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_ARCHIVAL_ENABLED=true

# =============================================================================
# MONITORING & ALERTING - PRODUCTION
# =============================================================================
# Error reporting and monitoring (production-grade)
ERROR_REPORTING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true
UPTIME_MONITORING_ENABLED=true

# Alert thresholds (strict for production)
ALERT_THRESHOLD_ERROR_RATE=2
ALERT_THRESHOLD_LATENCY=2000
ALERT_THRESHOLD_CPU_USAGE=80
ALERT_THRESHOLD_MEMORY_USAGE=80
ALERT_THRESHOLD_DISK_USAGE=85

# Health check configuration (production)
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=3000
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_ENDPOINTS=/health,/ready,/alive

# =============================================================================
# SECURITY CONFIGURATION - PRODUCTION
# =============================================================================
# Security settings for production (maximum security)
API_KEY_ROTATION_DAYS=30
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=30
PASSWORD_POLICY_ENABLED=true

# HTTPS and security headers (production)
FORCE_HTTPS=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
ENABLE_CSP=true
ENABLE_CSRF_PROTECTION=true
ENABLE_XSS_PROTECTION=true
ENABLE_CONTENT_TYPE_OPTIONS=true
ENABLE_FRAME_OPTIONS=true

# Security scanning
ENABLE_VULNERABILITY_SCANNING=true
ENABLE_DEPENDENCY_SCANNING=true
ENABLE_SECRET_SCANNING=true

# =============================================================================
# BACKUP & DISASTER RECOVERY - PRODUCTION
# =============================================================================
# Backup settings for production
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=365
BACKUP_STORAGE_BUCKET=production-backups-chess-engine-metrics
BACKUP_ENCRYPTION_KEY=SECURE_VAULT_backup_encryption_key

# Disaster recovery
DR_ENABLED=true
DR_RTO_MINUTES=15
DR_RPO_MINUTES=5
DR_SECONDARY_REGION=us-west1

# =============================================================================
# COMPLIANCE & AUDITING - PRODUCTION
# =============================================================================
# Compliance settings
ENABLE_AUDIT_TRAIL=true
AUDIT_LOG_RETENTION_DAYS=2555
ENABLE_DATA_CLASSIFICATION=true
ENABLE_PII_DETECTION=true

# Data governance
DATA_RETENTION_POLICY_ENABLED=true
GDPR_COMPLIANCE_ENABLED=true
DATA_ANONYMIZATION_ENABLED=true

# =============================================================================
# NOTIFICATION SERVICES - PRODUCTION
# =============================================================================
# Notification services for production (secure webhook URLs from vault)
DISCORD_WEBHOOK_URL=SECURE_VAULT_discord_webhook
SLACK_WEBHOOK_URL=SECURE_VAULT_slack_webhook
EMAIL_NOTIFICATION_ENABLED=true
SMS_NOTIFICATION_ENABLED=true
NOTIFICATION_THRESHOLD_ERROR_COUNT=3

# Escalation procedures
ENABLE_ESCALATION=true
ESCALATION_TIMEOUT_MINUTES=15
ON_CALL_ROTATION_ENABLED=true

# =============================================================================
# PERFORMANCE OPTIMIZATION - PRODUCTION
# =============================================================================
# Performance settings
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
ENABLE_COMPRESSION=true
ENABLE_CDN=true
CDN_CACHE_TTL=86400

# Resource limits
MAX_REQUEST_SIZE=10MB
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
CONNECTION_POOL_SIZE=20
# Staging Environment Variables Template
# Use this template for staging environment configuration
# Deploy these through secure environment variable management

# =============================================================================
# LICHESS API CONFIGURATION
# =============================================================================
# Lichess API token for v7p3r_bot (staging should use same bot with rate limiting)
LICHESS_API_TOKEN=your_production_lichess_token_here
LICHESS_BOT_USERNAME=v7p3r_bot
LICHESS_API_BASE_URL=https://lichess.org/api

# Rate limiting for staging (production-like but slightly more permissive)
LICHESS_RATE_LIMIT_PER_HOUR=1200
LICHESS_REQUEST_TIMEOUT=20000
LICHESS_RETRY_ATTEMPTS=3
LICHESS_RETRY_DELAY=5000

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Firebase project configuration for staging
FIREBASE_PROJECT_ID=chess-engine-metrics-agent-staging
FIREBASE_DATABASE_URL=https://chess-engine-metrics-agent-staging-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=chess-engine-metrics-agent-staging.appspot.com

# Firebase Functions configuration (staging)
FUNCTIONS_TIMEOUT=300s
FUNCTIONS_MEMORY=512MB
FUNCTIONS_MIN_INSTANCES=0
FUNCTIONS_MAX_INSTANCES=5

# =============================================================================
# GOOGLE CLOUD CONFIGURATION
# =============================================================================
# Google Cloud project for E2 instance integration
GCP_PROJECT_ID=v7p3r-lichess-bot
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=v7p3r-production-bot

# Service account for GCP operations (staging)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/staging-service-account.json

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Node.js environment
NODE_ENV=staging

# Logging configuration (moderate detail for staging)
LOG_LEVEL=info
ENABLE_DETAILED_LOGGING=false
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_REPORTING=true

# Security configuration (production-like)
ENABLE_CORS=true
CORS_ORIGINS=https://chess-engine-metrics-agent-staging.web.app
ENABLE_RATE_LIMITING=true
ENABLE_AUTH_VALIDATION=true
REQUIRE_EMAIL_VERIFICATION=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Firestore settings (staging)
FIRESTORE_CACHE_SIZE=100MB
FIRESTORE_OFFLINE_PERSISTENCE=false
FIRESTORE_CONNECTION_POOL_SIZE=10

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================
# AI service configuration (staging)
AI_SERVICE_PORT=5020
AI_SERVICE_HOST=localhost
AI_MODEL_TEMPERATURE=0.7
AI_MAX_TOKENS=1000
AI_RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================
# Analytics and reporting (staging)
ANALYTICS_BATCH_SIZE=50
ANALYTICS_PROCESSING_INTERVAL=600000
ENABLE_REAL_TIME_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Error reporting and monitoring
ERROR_REPORTING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true
ALERT_THRESHOLD_ERROR_RATE=5
ALERT_THRESHOLD_LATENCY=3000

# Health check configuration
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Security settings for staging
API_KEY_ROTATION_DAYS=90
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# HTTPS and security headers
FORCE_HTTPS=true
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_CSRF_PROTECTION=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup settings for staging
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_BUCKET=staging-backups-chess-engine-metrics

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================
# Notification services for staging
DISCORD_WEBHOOK_URL=staging_discord_webhook_url
SLACK_WEBHOOK_URL=staging_slack_webhook_url
EMAIL_NOTIFICATION_ENABLED=true
NOTIFICATION_THRESHOLD_ERROR_COUNT=10
# Development Environment Variables Template
# Copy this file to .env in the project root and fill in your development values
# DO NOT COMMIT the actual .env file with real secrets

# =============================================================================
# LICHESS API CONFIGURATION
# =============================================================================
# Lichess API token for v7p3r_bot
# Development: Use a separate test bot token if available
LICHESS_API_TOKEN=your_development_lichess_token_here
LICHESS_BOT_USERNAME=v7p3r_bot
LICHESS_API_BASE_URL=https://lichess.org/api

# Rate limiting for development (more permissive)
LICHESS_RATE_LIMIT_PER_HOUR=2000
LICHESS_REQUEST_TIMEOUT=30000

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Firebase project configuration for development
FIREBASE_PROJECT_ID=chess-engine-metrics-agent-dev
FIREBASE_DATABASE_URL=https://chess-engine-metrics-agent-dev-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=chess-engine-metrics-agent-dev.appspot.com

# Firebase Functions configuration
FUNCTIONS_TIMEOUT=60s
FUNCTIONS_MEMORY=256MB
FUNCTIONS_MIN_INSTANCES=0
FUNCTIONS_MAX_INSTANCES=10

# =============================================================================
# GOOGLE CLOUD CONFIGURATION
# =============================================================================
# Google Cloud project for E2 instance integration
GCP_PROJECT_ID=v7p3r-lichess-bot
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=v7p3r-production-bot

# Service account for GCP operations (development)
GOOGLE_APPLICATION_CREDENTIALS=path/to/development-service-account.json

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Node.js environment
NODE_ENV=development

# Logging configuration
LOG_LEVEL=debug
ENABLE_DETAILED_LOGGING=true
ENABLE_REQUEST_LOGGING=true

# Security configuration (relaxed for development)
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
ENABLE_RATE_LIMITING=false
ENABLE_AUTH_VALIDATION=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Firestore settings
FIRESTORE_CACHE_SIZE=unlimited
FIRESTORE_OFFLINE_PERSISTENCE=true

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================
# AI service configuration
AI_SERVICE_PORT=5020
AI_SERVICE_HOST=localhost
AI_MODEL_TEMPERATURE=0.7
AI_MAX_TOKENS=1000

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================
# Analytics and reporting
ANALYTICS_BATCH_SIZE=100
ANALYTICS_PROCESSING_INTERVAL=300000
ENABLE_REAL_TIME_ANALYTICS=true

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Firebase Emulator configuration
FIREBASE_EMULATOR_HOST=localhost
FIRESTORE_EMULATOR_HOST=localhost:8090
FUNCTIONS_EMULATOR_HOST=localhost:5010
STORAGE_EMULATOR_HOST=localhost:9199

# Development debugging
ENABLE_DEBUG_MODE=true
ENABLE_MOCK_DATA=false
MOCK_LICHESS_RESPONSES=false

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# Optional services and integrations
DISCORD_WEBHOOK_URL=optional_discord_webhook_for_notifications
SLACK_WEBHOOK_URL=optional_slack_webhook_for_notifications
EMAIL_NOTIFICATION_ENABLED=false
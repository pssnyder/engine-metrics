{
  "projectId": "chess-engine-metrics-agent-staging",
  "description": "Staging environment configuration for testing deployments",
  "environment": "staging",
  "configuration": {
    "hosting": {
      "public": "src/frontend/build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "https://chess-engine-metrics-agent-staging.web.app"
            }
          ]
        }
      ]
    },
    "firestore": {
      "rules": "config/firestore.rules",
      "indexes": "config/firestore.indexes.json"
    },
    "storage": {
      "rules": "config/storage.rules"
    },
    "functions": {
      "source": "src/backend/functions",
      "runtime": "nodejs18",
      "timeout": "300s",
      "memory": "512MB",
      "environmentVariables": {
        "NODE_ENV": "staging",
        "LOG_LEVEL": "info",
        "ENABLE_DETAILED_LOGGING": "false",
        "API_RATE_LIMIT": "500",
        "LICHESS_API_BASE_URL": "https://lichess.org/api"
      }
    }
  },
  "features": {
    "enableEmulators": false,
    "enableDetailedLogging": false,
    "enableCORS": true,
    "enableRateLimiting": true,
    "enableAuthentication": true
  },
  "services": {
    "lichessApi": {
      "baseUrl": "https://lichess.org/api"
    },
    "analytics": {
      "enabled": true,
      "port": 5020
    }
  },
  "monitoring": {
    "errorReporting": true,
    "performanceMonitoring": true,
    "alerting": {
      "errorThreshold": 10,
      "latencyThreshold": 5000
    }
  }
}
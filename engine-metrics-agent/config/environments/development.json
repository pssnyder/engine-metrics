{
  "projectId": "chess-engine-metrics-agent-dev",
  "description": "Development environment configuration",
  "environment": "development",
  "configuration": {
    "hosting": {
      "public": "src/frontend/build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        }
      ]
    },
    "firestore": {
      "rules": "config/firestore.rules",
      "indexes": "config/firestore.indexes.json"
    },
    "storage": {
      "rules": "config/storage.rules"
    },
    "functions": {
      "source": "src/backend/functions",
      "runtime": "nodejs18",
      "timeout": "60s",
      "memory": "256MB",
      "environmentVariables": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug",
        "ENABLE_DETAILED_LOGGING": "true",
        "API_RATE_LIMIT": "1000",
        "LICHESS_API_BASE_URL": "https://lichess.org/api"
      }
    },
    "emulators": {
      "functions": {
        "port": 5010
      },
      "firestore": {
        "port": 8090
      },
      "storage": {
        "port": 9199
      },
      "hosting": {
        "port": 5000
      },
      "ui": {
        "enabled": true,
        "port": 4010
      },
      "hub": {
        "port": 4410
      },
      "logging": {
        "port": 4510
      },
      "singleProjectMode": true
    }
  },
  "features": {
    "enableEmulators": true,
    "enableDetailedLogging": true,
    "enableCORS": true,
    "enableRateLimiting": false,
    "enableAuthentication": false
  },
  "services": {
    "lichessApi": {
      "baseUrl": "https://lichess.org/api"
    },
    "analytics": {
      "enabled": true,
      "port": 5020
    }
  }
}
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Enterprise Security Best Practices Implementation
    // Author: RTS Technology & Solutions LLC
    // Project: Chess Engine Metrics Agent
    // Security Level: Private/Internal Use
    // Last Updated: October 14, 2025
    
    // Helper function to check if user is the admin (your email)
    // Implements principle of least privilege with email verification
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == "pat@rapidtechconsultants.com" &&
             request.auth.token.email_verified == true;
    }
    
    // Helper function for authenticated and verified users
    function isAuthenticatedAndVerified() {
      return request.auth != null && 
             request.auth.token.email_verified == true;
    }
    
    // Helper function to validate file types (security measure)
    function isAllowedFileType() {
      return resource.contentType in ['application/json', 
                                    'text/plain', 
                                    'application/x-chess-pgn',
                                    'text/markdown',
                                    'application/octet-stream'] ||
             resource.contentType.matches('text/.*') ||
             request.resource.contentType in ['application/json', 
                                            'text/plain', 
                                            'application/x-chess-pgn',
                                            'text/markdown',
                                            'application/octet-stream'] ||
             request.resource.contentType.matches('text/.*');
    }
    
    // Helper function to limit file size (10MB max for security)
    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }
    
    // V7P3R raw data - Admin only access with file validation
    match /raw-data/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isAllowedFileType() && isReasonableSize();
      allow delete: if isAdmin();
    }
    
    // Processed data storage - Admin only with enhanced validation
    match /processed-data/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isAllowedFileType() && isReasonableSize();
      allow delete: if isAdmin();
    }
    
    // Exports and reports - Admin only
    match /exports/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isAllowedFileType() && isReasonableSize();
      allow delete: if isAdmin();
    }
    
    // Backup storage for critical data
    match /backups/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isAllowedFileType() && isReasonableSize();
      allow delete: if false; // Backups should not be deletable through client
    }
    
    // Legacy paths that might exist - Admin only
    match /analysis_results/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isAllowedFileType() && isReasonableSize();
      allow delete: if isAdmin();
    }
    
    match /game_results/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isAllowedFileType() && isReasonableSize();
      allow delete: if isAdmin();
    }
    
    match /v7p3r_docs/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isAllowedFileType() && isReasonableSize();
      allow delete: if isAdmin();
    }
    
    // User-specific directories (future-proofing for multi-user support)
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticatedAndVerified() && request.auth.uid == userId;
      allow write: if isAuthenticatedAndVerified() && 
                     request.auth.uid == userId && 
                     isAllowedFileType() && 
                     isReasonableSize();
      allow delete: if isAuthenticatedAndVerified() && request.auth.uid == userId;
    }
    
    // Temporary upload area with automatic cleanup
    match /temp/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticatedAndVerified() && 
                           request.auth.uid == userId && 
                           isAllowedFileType() && 
                           isReasonableSize();
      allow delete: if isAuthenticatedAndVerified() && request.auth.uid == userId;
    }
    
    // Enterprise Security: Explicit deny all other access
    // This implements default-deny security posture
    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}